#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
(cd backend; set -a; if [ -f .env ]; then . ./.env; fi; set +a; exec .venv/bin/gunicorn server.wsgi:application --bind 127.0.0.1:8000 --workers 2 --access-logfile -) &
api_pid=$!
(cd frontend; mkdir -p .next/standalone/public .next/standalone/.next/static; cp -R public/. .next/standalone/public/; cp -R .next/static/. .next/standalone/.next/static/; HOSTNAME=127.0.0.1 PORT=3000 exec node .next/standalone/server.js) &
web_pid=$!
trap 'kill "$api_pid" "$web_pid" 2>/dev/null || true' EXIT INT TERM
wait
